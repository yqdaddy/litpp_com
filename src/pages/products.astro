---
import Base from '@/layouts/Base.astro';

const products = [
  {
    name: 'AI 内容生成系统',
    status: 'live',
    statusText: '运行中',
    desc: '基于 LLM 的结构化内容生产管线。从 Prompt 工程到输出质量控制，覆盖内容策划、生成、审核全流程。',
    tags: ['LLM', 'Prompt Engineering', '内容管线'],
    note: '不是 ChatGPT wrapper，是真正的内容工程化。',
  },
  {
    name: '数据驱动决策平台',
    status: 'live',
    statusText: '运行中',
    desc: '整合多数据源的分析决策系统。将业务指标、用户行为、市场数据汇聚为可操作的决策依据。',
    tags: ['数据分析', '决策引擎', '可视化'],
    note: '系统思维的具体落地：让数据说话，而不是直觉。',
  },
  {
    name: '自动化运维 & CI/CD 体系',
    status: 'iter',
    statusText: '持续迭代',
    desc: '从代码提交到生产部署的全链路自动化。包含质量门禁、灰度发布、监控告警闭环。',
    tags: ['DevOps', 'CI/CD', '自动化'],
    note: '工程能力的底座：让团队把精力花在值得花的地方。',
  },
  {
    name: 'AI 辅助代码审查系统',
    status: 'exp',
    statusText: '实验中',
    desc: '利用 LLM 辅助代码审查，自动识别潜在问题、生成审查意见、追踪技术债务。',
    tags: ['AI', 'Code Review', '工程效率'],
    note: '探索 AI 在工程流程中的深度嵌入。',
  },
];

const creeds = [
  {
    title: '系统思维优先',
    desc: '不做孤立的功能点，做可演化的系统。每个决策都考虑长期影响。',
  },
  {
    title: 'AI 是工具，不是目的',
    desc: 'AI 的价值在于解决真实问题。避免为了用 AI 而用 AI。',
  },
  {
    title: '工程质量即产品质量',
    desc: '可维护的代码、可靠的部署、清晰的监控，这些不是"技术债"，是产品的一部分。',
  },
  {
    title: '小团队，大杠杆',
    desc: '用自动化和 AI 放大个人和小团队的产出。做 10 人效率的 3 人团队。',
  },
];
---

<Base title="产品" description="产品与系统构建，系统思维驱动的工程实践。">
  <section class="section">
    <div class="container">
      <header class="page-head">
        <h1 class="page-title">产品与系统</h1>
        <p class="page-desc">
          不只是做产品，更是构建系统。每一个项目背后，是对"如何用工程方法解决真实问题"的持续回答。
        </p>
      </header>

      <div class="ledger">
        {products.map((product, i) => (
          <article class="ledger-row">
            <div class="ledger-head">
              <h2 class="ledger-name">{product.name}</h2>
              <span class={`status status-${product.status}`}>{product.statusText}</span>
            </div>
            <div class="ledger-body">
              <p class="ledger-desc">{product.desc}</p>
              <p class="ledger-note">{product.note}</p>
              <div class="tag-row">
                {product.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="philosophy">
        <div class="section-head">
          <h2>构建哲学</h2>
        </div>
        <div class="creed-grid">
          {creeds.map(creed => (
            <div class="creed">
              <h3>{creed.title}</h3>
              <p>{creed.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    margin-bottom: var(--space-7);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: var(--text-h1);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-3);
  }

  .page-desc {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    max-width: 40em;
    line-height: var(--leading-body);
  }

  /* Ledger */
  .ledger {
    margin-bottom: var(--space-9);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-5);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }

  .ledger-row:first-child {
    border-top: 1px solid var(--color-border-strong);
  }

  .ledger-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .ledger-name {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  .ledger-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    margin-bottom: var(--space-3);
    line-height: var(--leading-body);
  }

  .ledger-note {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-3);
    margin-bottom: var(--space-3);
    line-height: var(--leading-body);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  /* Creed */
  .philosophy {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-7);
  }

  .creed-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-7);
  }

  .creed {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .creed h3 {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }

  .creed p {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: var(--leading-body);
  }

  @media (max-width: 768px) {
    .ledger-row {
      grid-template-columns: 1fr;
    }
    .creed-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>