---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { GAME_URL } from '@/consts';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero-label">CTO's AI Lab</p>
      <h1 class="hero-title">把 AI、产品、工程<br/>真正串起来的实验场</h1>
      <p class="hero-desc">
        不是个人简历，不是工具导航站。<br/>
        这里记录一个 CTO 在 AI 时代的系统思考、工程实践与产品实验。
      </p>
      <div class="hero-actions">
        <a href="/lab" class="btn btn-primary">进入实验场</a>
        <a href="/blog" class="btn">阅读博客</a>
      </div>
    </div>
  </section>

  <!-- What I Do -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">正在做的事</h2>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">⚙️</div>
          <h3>AI 工程化</h3>
          <p>探索 LLM 在实际产品中的落地路径——不只是 demo，而是可交付、可迭代的系统。</p>
          <a href="/products" class="card-link">查看产品 &rarr;</a>
        </div>
        <div class="card">
          <div class="card-icon">🧪</div>
          <h3>实验与原型</h3>
          <p>快速验证想法的 Playground。包括数学工具、交互小游戏、AI 辅助工具等。</p>
          <a href="/lab" class="card-link">进入实验场 &rarr;</a>
        </div>
        <div class="card">
          <div class="card-icon">📝</div>
          <h3>技术写作</h3>
          <p>实验日志 + 方法论输出。记录 AI 工程化过程中的真实思考与决策。</p>
          <a href="/blog" class="card-link">阅读博客 &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Game Entry -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">小游戏 & 工具</h2>
      <a href={GAME_URL} target="_blank" rel="noopener" class="game-banner card">
        <div class="game-banner-content">
          <h3>game.litpp.com</h3>
          <p>数学小游戏、思维训练工具、AI 驱动的交互实验。点击进入 →</p>
        </div>
        <div class="game-banner-badge">↗</div>
      </a>
    </div>
  </section>

  <!-- Recent Posts -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section-title">最近文章</h2>
        <div class="post-list">
          {posts.map(post => (
            <a href={`/blog/${post.id}`} class="post-item card">
              <div class="post-item-meta">
                <span class="tag">{post.data.category}</span>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
        <div style="margin-top: 2rem;">
          <a href="/blog" class="btn">查看全部文章 &rarr;</a>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  /* Hero */
  .hero {
    padding: 6rem 0 4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .hero-desc {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 540px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  /* Grid */
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .card-icon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .card h3 {
    margin-bottom: 0.5rem;
  }

  .card p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .card-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* Game Banner */
  .game-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
  }

  .game-banner h3 {
    font-family: var(--font-mono);
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .game-banner p {
    margin-bottom: 0;
  }

  .game-banner-badge {
    font-size: 1.5rem;
    color: var(--color-text-muted);
    transition: color var(--transition);
  }

  .game-banner:hover .game-banner-badge {
    color: var(--color-accent);
  }

  /* Post List */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-item {
    text-decoration: none;
  }

  .post-item-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .post-item h3 {
    margin-bottom: 0.35rem;
    color: var(--color-heading);
    transition: color var(--transition);
  }

  .post-item:hover h3 {
    color: var(--color-accent);
  }

  .post-item p {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 3rem;
    }

    .hero-title {
      font-size: 2rem;
    }

    .grid-3 {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
