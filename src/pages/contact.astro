---
import Base from '@/layouts/Base.astro';

const topics = [
  {
    title: '技术合作',
    desc: 'AI 工程化落地、系统架构设计、技术团队搭建相关的合作咨询。',
  },
  {
    title: '产品交流',
    desc: '对已有产品的反馈，或希望一起探索的产品方向。',
  },
  {
    title: '开源 & 社区',
    desc: '对实验场项目感兴趣，想贡献代码或想法。',
  },
];
---

<Base title="联系" description="技术合作、产品交流、开源社区。">
  <section class="section">
    <div class="container">
      <header class="page-head">
        <h1 class="page-title">联系我</h1>
        <p class="page-desc">
          欢迎就以下话题交流。不卖课、不接广告，只聊值得聊的事。
        </p>
      </header>

      <div class="contact-grid">
        <div class="topics">
          {topics.map((topic, i) => (
            <article class="topic">
              <h3>{topic.title}</h3>
              <p>{topic.desc}</p>
            </article>
          ))}
        </div>
        <aside class="contact-card">
          <h2 class="contact-email">
            <a href="mailto:hi@litpp.com">hi@litpp.com</a>
          </h2>
          <ul class="contact-links">
            <li>
              <span>GitHub</span>
              <a href="https://github.com/yqdaddy" target="_blank" rel="noopener">github.com/yqdaddy ↗</a>
            </li>
            <li>
              <span>网站</span>
              <a href="https://litpp.com">litpp.com</a>
            </li>
            <li>
              <span>公众号</span>
              <span class="wechat-name">mamaaios</span>
            </li>
          </ul>
          <div class="wechat-qr">
            <img src="/images/wechat-qr.jpg" alt="公众号 mamaaios 二维码" />
            <p>扫码关注公众号</p>
          </div>
          <p class="contact-hint">建议优先使用 Email。请简要说明来意，我会尽快回复。</p>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    margin-bottom: var(--space-7);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: var(--text-h1);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-3);
  }

  .page-desc {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    line-height: var(--leading-body);
  }

  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-7);
  }

  /* Topics */
  .topics {
    display: flex;
    flex-direction: column;
  }

  .topic {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }

  .topic:first-child {
    border-top: 1px solid var(--color-border-strong);
  }

  .topic h3 {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }

  .topic p {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    margin: 0;
    line-height: var(--leading-body);
  }

  /* Contact Card */
  .contact-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .contact-email {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1rem + 2vw, 2rem);
    font-weight: 700;
    margin-bottom: var(--space-5);
  }

  .contact-email a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
    transition: color var(--dur-1) var(--ease-out-quiet);
  }

  .contact-email a:hover {
    color: var(--color-accent);
  }

  .contact-links {
    list-style: none;
    margin-bottom: var(--space-5);
  }

  .contact-links li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
  }

  .contact-links li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .contact-links span {
    font-size: var(--text-sm);
    color: var(--color-ink-3);
  }

  .contact-links a {
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
  }

  .contact-links a:hover {
    color: var(--color-accent);
  }

  .contact-hint {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    margin: 0;
    line-height: var(--leading-body);
  }

  .wechat-name {
    font-size: var(--text-sm);
    color: var(--color-ink);
    font-family: var(--font-mono);
  }

  .wechat-qr {
    text-align: center;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .wechat-qr img {
    width: 120px;
    height: 120px;
    border: 1px solid var(--color-border);
  }

  .wechat-qr p {
    font-size: var(--text-meta);
    color: var(--color-ink-3);
    margin: var(--space-2) 0 0;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>